{
    "name": "aws-freenas-backup",
    "version": "0.1.0",
    "bin": {
        "aws-freenas-backup": "bin/aws-freenas-backup.js"
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "cdk": "cdk",
        "deploy": "npm run -s build && cdk deploy --require-approval broadening",
        "diff": "npm run -s build && cdk diff",
        "synth": "npm run -s build && cdk synth"
    },
    "prettier": {
        "arrowParens": "always",
        "bracketSpacing": true,
        "endOfLine": "lf",
        "printWidth": 100,
        "semi": true,
        "singleQuote": true,
        "tabWidth": 4,
        "trailingComma": "es5",
        "useTabs": false
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^5.45.0",
        "@typescript-eslint/parser": "^5.45.0",
        "aws-cdk": "^2.86.0",
        "eslint": "^8.44.0",
        "eslint-config-prettier": "^8.0.0",
        "eslint-plugin-prettier": "^4.2.1",
        "prettier": "^2.8.0",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "aws-cdk-lib": "^2.0.0"
    }
}
